# This is an example environment file for the Songbook web app.
# Copy this file to .env and edit the values as needed.
export SONGBOOK_MUSIC_DIR=./music
export SONGBOOK_CONTENT_DIR=./content
export SONGBOOK_ADMIN_PASSWORD=admin
export SONGBOOK_LANGUAGES=en,es,fr
export SONGBOOK_LANGUAGES_DEFAULT=es
# Port for the read-only public instance (songbook-public service)
export SONGBOOK_PUBLIC_PORT=9000
# Navidrome Subsonic API for share links (original versions use Spotify instead).
# Omit these to disable Navidrome share links entirely.
# NOTE: the Navidrome server must run with EnableSharing=true and the user below
# must be allowed to create shares.
export SONGBOOK_NAVIDROME_SONGS_URL=
export SONGBOOK_NAVIDROME_USERNAME=
export SONGBOOK_NAVIDROME_PASSWORD=
# Spotify Web API for automatic embedded players (original versions are looked
# up by artist + title and embedded directly on the page). Omit to fall back to
# plain Spotify search links. Create a Spotify App in the Developer Dashboard
# to get a Client ID and Client Secret.
export SPOTIFY_CLIENT_ID=
export SPOTIFY_CLIENT_SECRET=